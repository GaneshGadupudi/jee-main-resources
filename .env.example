MSSQL_SERVER=localhost
MSSQL_INSTANCE=SQLEXPRESS
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_DATABASE=JEE_Preparation_Platform
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=
# Email (weekly summary). If SMTP_HOST is omitted, messages are printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:3000


# AI Tutor (free Google Gemini API). Get a key at https://aistudio.google.com/apikey, then restart the dev server.
GEMINI_API_KEY=your_gcp_api_key_here
# Optional: override the Gemini model if Google retires this one.
# GEMINI_MODEL=gemini-3.6-flash
